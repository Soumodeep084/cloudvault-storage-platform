generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  ACCOUNT_DELETE_OTP
  ACCOUNT_RESTORE_OTP
}

enum ActivityAction {
  UPLOAD
  SHARE
  DOWNLOAD
  SHARE_DOWNLOAD
  DELETE
}

model User {
  id         String  @id @default(uuid())
  email      String  @unique
  password   String
  name       String?
  role       Role    @default(USER)
  isVerified Boolean @default(false)
  deleted    Boolean @default(false)
  deletionScheduledAt DateTime? @map("deletion_scheduled_at")
  // emailNotifications Boolean @default(true)
  // twoFactorEnabled   Boolean @default(false)

  storageUsed   BigInt    @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files    File[]
  folders  Folder[]
  shares   Share[]
  folderShares FolderShare[]
  tokens   Token[]
  sessions Session[]
  activities Activity[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Added onDelete: Cascade
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Token {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  // Added onDelete: Cascade
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model File {
  id        String  @id @default(uuid())
  userId    String
  folderId  String?
  fileName  String
  fileUrl   String
  fileSize  Int?
  fileType  String?
  isDeleted Boolean @default(false)
  isTrashed Boolean @default(false)

  trashedDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Added onDelete: Cascade
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder     Folder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  shares     Share[]
  activities Activity[]

  @@index([userId])
  @@index([folderId])
}

model Folder {
  id        String   @id @default(uuid())
  userId    String
  parentId  String?
  name      String
  isDeleted Boolean  @default(false)
  isTrashed Boolean  @default(false)
  
  trashedDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderToFolder")
  files    File[]
  folderShares FolderShare[]
  activities Activity[]

  @@index([userId])
  @@index([parentId])
  @@unique([userId, parentId, name])
}

model Share {
  id        String    @id @default(uuid())
  fileId    String
  userId    String
  token     String    @unique
  password  String?
  isPublic  Boolean   @default(false)
  expiresAt DateTime?

  createdAt DateTime @default(now())

  // Added onDelete: Cascade for both relations
  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([userId])
}

model FolderShare {
  id        String    @id @default(uuid())
  folderId  String
  userId    String
  token     String    @unique
  password  String?
  isPublic  Boolean   @default(false)
  expiresAt DateTime?

  createdAt DateTime @default(now())

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([userId])
}

model Activity {
  id        String         @id @default(uuid())
  userId    String
  fileId    String?
  folderId  String?
  action    ActivityAction
  metadata  Json?
  createdAt DateTime       @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  file File? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([fileId])
  @@index([folderId])
  @@index([createdAt])
}

model SystemLog {
  id           String   @id @default(uuid())
  action       String
  targetUserId String?
  targetEmail  String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
